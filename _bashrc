alias whatismyip='dig +short myip.opendns.com @resolver1.opendns.com'


#
# Run all application global bashrc scripts from $HOME/.bashrc.d/global/ (ex: prompt, colors, etc.)
#

for globalscript in $HOME/.bashrc.d/global/*.bashrc ; do
  source $globalscript
done
unset globalscript

#
# Run platform specific bashrc scripts from $HOME/.bashrc.d/platform/ (ex: darwin, sunos, linux)
#

if [ -r "$HOME/.bashrc.d/platform/$platform.bashrc" ] ; then
	source $HOME/.bashrc.d/platform/$platform.bashrc
fi

#
# Run host specific bashrc scripts from $HOME/.bashrc.d/hosts/ (ex: bifrost, sunna, ragnarok)
#

if [ -r "$HOME/.bashrc.d/hosts/$hostname.bashrc" ] ; then
	source $HOME/.bashrc.d/hosts/$hostname.bashrc
fi

#
# Run all application specific bashrc scripts from $HOME/.bashrc.d/applications/ (ex: veritas)
#

for application in $HOME/.bashrc.d/applications/*.bashrc ; do
	source $application
done
unset application

#
# Run all custom bash completion scripts from $HOME/.bashrc.d/completions/
#

for completion in $HOME/.bashrc.d/completions/*.bashrc ; do
	source $completion
done
unset completion

#
# Set the EDITOR variable
#
export EDITOR=$(which vim)
if [ ! -x "$EDITOR" ] ; then
	export EDITOR=$(which vi)
fi

#
# Create socket directory for SSH ControlPath
#
test -d ~/.ssh/cm_socket || ( mkdir ~/.ssh/cm_socket ; chmod 0700 ~/.ssh/cm_socket )
