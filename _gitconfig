[user]
	name = Daniel Whicker
	email = daniel.whicker@sigmasolinc.com

[core]
	  editor = vi
	  excludesfile = /Users/daniel/.gitignore
	  autocrlf = input
	  pager = 

[color]
	branch = auto
	diff = auto
	interactive = auto
	status = auto
	ui = auto
	pager = true

[credential]
	helper = osxkeychain

[alias]
	co = checkout
	ci = commit
	st = status
	sb = status -sb
	br = branch
	hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
	type = cat-file -t
	dump = cat-file -p
	aa = add .
	url = remote get-url --all
