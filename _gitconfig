[user]
	name = Daniel Whicker
	email = daniel.whicker@sigmasolinc.com

[core]
	  editor = vi
	  excludesfile = /Users/daniel/.gitignore
	  autocrlf = input
	  pager = 

[color]
	branch = auto
	diff = auto
	interactive = auto
	status = auto
	ui = auto
	pager = true

[credential]
	helper = osxkeychain

[alias]
	co = checkout
	ci = commit
	st = status
	sb = status -sb
	br = branch
	hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
	type = cat-file -t
	dump = cat-file -p
	aa = add .
	url = remote get-url --all

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	features = side-by-side line-numbers decorations
	whitespace-error-style = 22 reverse

[delta "decorations"]
	commit-decoration-style = bold yellow box ul
	file-style = bold yellow ul
	file-decoration-style = none
